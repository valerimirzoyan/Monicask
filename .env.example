# Runtime
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./monicask.db

# Asterisk / FreePBX AMI. Leave AMI_HOST empty to run in mock mode.
AMI_HOST=
AMI_PORT=5038
AMI_USERNAME=workplace
AMI_SECRET=change-me
AMI_TIMEOUT=5.0
AMI_MAX_ATTEMPTS=3
AMI_RETRY_BACKOFF=0.25
# JSON list of queues the service is allowed to manage
MANAGED_QUEUES=["sales","support"]

# Zammad. Leave ZAMMAD_BASE_URL empty to run in mock mode.
ZAMMAD_BASE_URL=
ZAMMAD_TOKEN=
ZAMMAD_TIMEOUT=5.0
FINAL_TICKET_STATUS=closed
WEBHOOK_SECRET=

# Post-call processing
WRAP_UP_ENABLED=false
WRAP_UP_SECONDS=30
